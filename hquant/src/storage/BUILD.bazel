load("//:hquant_cc.bzl", "hquant_cc_library")

hquant_cc_library(
    name = "storage",
    hdrs = ["storage.h"],
    deps = [
        "//hquant/src/base:types",
        "//hquant/src/base:order",
        "//hquant/src/base:error",
        "@abseil-cpp//absl/status:status",
    ],
    visibility = ["//visibility:public"],
)

hquant_cc_library(
    name = "record_codec",
    srcs = ["record_codec.cc"],
    hdrs = ["record_codec.h"],
    deps = [
        ":storage",
        "//hquant/src/base:types",
        "//hquant/src/base:error",
        "@abseil-cpp//absl/status:status",
        "@abseil-cpp//absl/status:statusor",
    ],
    visibility = ["//hquant/src/storage:__pkg__", "//hquant/test:__pkg__"],
)

hquant_cc_library(
    name = "recorder",
    srcs = ["recorder.cc"],
    hdrs = ["recorder.h"],
    data = ["schema.sql"],
    deps = [
        ":storage",
        ":record_codec",
        "//hquant/src/base:error",
        "@abseil-cpp//absl/status:status",
        "@abseil-cpp//absl/status:statusor",
        "@sqlite3//:sqlite3",
    ],
    visibility = ["//hquant/src/application:__pkg__", "//hquant/test:__pkg__"],
)

hquant_cc_library(
    name = "history",
    srcs = ["history.cc"],
    hdrs = ["history.h"],
    deps = [
        ":storage",
        ":record_codec",
        "//hquant/src/base:error",
        "@abseil-cpp//absl/status:status",
        "@abseil-cpp//absl/status:statusor",
        "@sqlite3//:sqlite3",
    ],
    visibility = ["//hquant/src/application:__pkg__", "//hquant/test:__pkg__"],
)
