load("//:hquant_cc.bzl", "hquant_cc_library")

hquant_cc_library(
    name = "order_history",
    hdrs = ["order_history.h"],
    deps = [
        "//hquant/src/base:types",
        "//hquant/src/base:order",
        "//hquant/src/base:error",
        "@abseil-cpp//absl/status:status",
    ],
    visibility = ["//visibility:public"],
)

hquant_cc_library(
    name = "record_codec",
    srcs = ["record_codec.cc"],
    hdrs = ["record_codec.h"],
    deps = [
        ":order_history",
        "//hquant/src/base:types",
        "//hquant/src/base:error",
        "@abseil-cpp//absl/status:status",
        "@abseil-cpp//absl/status:statusor",
    ],
    visibility = ["//hquant/src/order_history:__pkg__", "//hquant/test:__pkg__"],
)

hquant_cc_library(
    name = "order_history_writer",
    srcs = ["order_history_writer.cc"],
    hdrs = ["order_history_writer.h"],
    data = ["schema.sql"],
    deps = [
        ":order_history",
        ":record_codec",
        "//hquant/src/base:error",
        "@abseil-cpp//absl/status:status",
        "@abseil-cpp//absl/status:statusor",
        "@sqlite3//:sqlite3",
    ],
    visibility = ["//hquant/src/application:__pkg__", "//hquant/test:__pkg__"],
)

hquant_cc_library(
    name = "order_history_reader",
    srcs = ["order_history_reader.cc"],
    hdrs = ["order_history_reader.h"],
    deps = [
        ":order_history",
        ":record_codec",
        "//hquant/src/base:error",
        "@abseil-cpp//absl/status:status",
        "@abseil-cpp//absl/status:statusor",
        "@boost.asio//:boost.asio",
        "@sqlite3//:sqlite3",
    ],
    visibility = ["//hquant/src/application:__pkg__", "//hquant/test:__pkg__"],
)
