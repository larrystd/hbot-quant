load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

filegroup(name = "order_book_data", srcs = glob(["fixtures/order_book/*.json"]))
filegroup(name = "order_tracker_data", srcs = glob(["fixtures/order_tracker/*.json"]))
filegroup(name = "simple_pmm_data", srcs = glob(["fixtures/simple_pmm/*.json"]))
filegroup(name = "simulated_exchange_data", srcs = glob(["fixtures/simulated_exchange/*.json"]))

cc_library(
    name = "fixture_loader",
    srcs = ["fixture_loader.cc"],
    hdrs = ["fixture_loader.h"],
    deps = [
        "//hquant/src/base:types",
        "@abseil-cpp//absl/status:status",
        "@abseil-cpp//absl/status:statusor",
        "@simdjson//:simdjson",
    ],
)

cc_test(name = "types_test", srcs = ["types_test.cc"], deps = ["//hquant/src/base:types", "//hquant/src/base:market", "//hquant/src/base:order"])
cc_test(name = "error_test", srcs = ["error_test.cc"], deps = ["//hquant/src/base:error", "@abseil-cpp//absl/strings:cord", "@googletest//:gtest_main"])
cc_test(name = "net_test", srcs = ["net_test.cc"], deps = ["//hquant/src/base:error", "//hquant/src/base:net", "@boost.asio//:boost.asio", "@boost.beast//:boost.beast", "@googletest//:gtest_main"])
cc_test(name = "rate_limit_test", srcs = ["rate_limit_test.cc"], deps = ["//hquant/src/base:rate_limit", "@googletest//:gtest_main"])
cc_test(name = "order_book_test", srcs = ["order_book_test.cc"], data = [":order_book_data"], deps = [":fixture_loader", "//hquant/src/market:order_book", "@simdjson//:simdjson"])
cc_test(name = "market_data_stream_test", srcs = ["market_data_stream_test.cc"], data = [":order_book_data"], deps = [":fixture_loader", "//hquant/src/base:error", "//hquant/src/base:net", "//hquant/src/market:order_book", "//hquant/src/market:market_data_stream", "@boost.asio//:boost.asio", "@boost.beast//:boost.beast", "@googletest//:gtest_main", "@simdjson//:simdjson"])

cc_test(name = "order_tracker_test", srcs = ["order_tracker_test.cc"], data = [":order_tracker_data"], deps = [":fixture_loader", "//hquant/src/base:error", "//hquant/src/order:order_tracker", "@googletest//:gtest_main", "@simdjson//:simdjson"])
cc_test(name = "risk_test", srcs = ["risk_test.cc"], deps = ["//hquant/src/base:error", "//hquant/src/order:risk"])
cc_test(name = "simulated_exchange_test", srcs = ["simulated_exchange_test.cc"], data = [":simulated_exchange_data"], deps = [":fixture_loader", "//hquant/src/base:error", "//hquant/src/order:simulated_exchange", "@googletest//:gtest_main", "@simdjson//:simdjson"])
cc_test(name = "order_gateway_test", srcs = ["order_gateway_test.cc"], deps = ["//hquant/src/base:error", "//hquant/src/order:order_gateway", "@boost.asio//:boost.asio", "@googletest//:gtest_main"])
cc_test(name = "account_reports_test", srcs = ["account_reports_test.cc"], deps = ["//hquant/src/base:error", "//hquant/src/order:account_reports", "//hquant/src/order:order_tracker", "@boost.asio//:boost.asio", "@googletest//:gtest_main"])
cc_test(name = "simple_pmm_test", srcs = ["simple_pmm_test.cc"], data = [":simple_pmm_data"], deps = [":fixture_loader", "//hquant/src/strategy:simple_pmm", "@googletest//:gtest_main", "@simdjson//:simdjson"])

cc_test(name = "recorder_test", srcs = ["recorder_test.cc"], deps = ["//hquant/src/base:error", "//hquant/src/storage:history", "//hquant/src/storage:recorder", "@googletest//:gtest_main"])
cc_test(name = "history_test", srcs = ["history_test.cc"], deps = ["//hquant/src/base:error", "//hquant/src/storage:history", "//hquant/src/storage:recorder", "@googletest//:gtest_main"])
cc_test(name = "record_codec_test", srcs = ["record_codec_test.cc"], deps = ["//hquant/src/base:error", "//hquant/src/storage:record_codec", "@googletest//:gtest_main"])
cc_test(name = "shard_test", srcs = ["shard_test.cc"], deps = ["//hquant/src/shard:shard"])
cc_test(name = "shard_trigger_test", srcs = ["shard_trigger_test.cc"], deps = ["//hquant/src/shard:shard", "//hquant/src/order:risk", "//hquant/src/order:simulated_exchange", "@googletest//:gtest_main"])
cc_test(name = "action_executor_test", srcs = ["action_executor_test.cc"], deps = ["//hquant/src/shard:action_executor"])
cc_test(name = "routing_test", srcs = ["routing_test.cc"], deps = ["//hquant/src/shard:routing", "@googletest//:gtest_main"])

cc_test(name = "control_server_test", srcs = ["control_server_test.cc"], deps = ["//hquant/src/application:control_server", "//hquant/src/cli:cli", "//hquant/src/storage:storage", "@googletest//:gtest_main"])
cc_test(name = "config_test", srcs = ["config_test.cc"], deps = ["//hquant/src/application:config", "//hquant/src/base:error"])
cc_test(name = "cli_test", srcs = ["cli_test.cc"], deps = ["//hquant/src/base:error", "//hquant/src/cli:cli"])

cc_test(name = "simulated_replay", srcs = ["simulated_replay_test.cc"], deps = ["//hquant/src/base:error", "//hquant/src/base:types", "//hquant/src/order:simulated_exchange", "//hquant/src/order:risk", "//hquant/src/shard:shard", "//hquant/src/storage:history", "//hquant/src/storage:recorder", "//hquant/src/strategy:simple_pmm", "@googletest//:gtest_main"])
cc_test(name = "simulated_binance", srcs = ["simulated_binance_test.cc"], deps = ["//hquant/src/market:market_data_stream", "//hquant/src/order:simulated_exchange", "//hquant/src/base:net", "//hquant/src/order:risk", "//hquant/src/shard:shard", "//hquant/src/strategy:simple_pmm", "@boost.asio//:boost.asio", "@boost.beast//:boost.beast", "@googletest//:gtest_main"])
cc_test(name = "multi_shard", srcs = ["multi_shard_test.cc"], deps = ["//hquant/src/base:rate_limit", "//hquant/src/order:risk", "//hquant/src/shard:routing", "@googletest//:gtest_main"])
cc_test(name = "recovery", srcs = ["recovery_test.cc"], deps = ["//hquant/src/order:order_gateway", "//hquant/src/order:account_reports", "//hquant/src/order:order_tracker", "//hquant/src/order:risk", "//hquant/src/storage:history", "//hquant/src/storage:recorder", "@abseil-cpp//absl/status:status", "@boost.asio//:boost.asio", "@googletest//:gtest_main"])

cc_test(
    name = "schema_test",
    size = "small",
    srcs = ["fixture_schema_test.cc"],
    data = glob(["fixtures/order_book/*.json", "fixtures/order_tracker/*.json", "fixtures/simple_pmm/*.json", "fixtures/simulated_exchange/*.json"]),
    deps = [":fixture_loader"],
)

cc_test(
    name = "simulated_exchange_schema_test",
    size = "small",
    srcs = ["fixture_schema_test.cc"],
    args = ["--simulated_exchange"],
    data = glob(["fixtures/order_book/*.json", "fixtures/order_tracker/*.json", "fixtures/simple_pmm/*.json", "fixtures/simulated_exchange/*.json"]),
    deps = [":fixture_loader"],
)
