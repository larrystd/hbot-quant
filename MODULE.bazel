    name = "mpdecimal",
    build_file = "//third_party/mpdecimal:mpdecimal.BUILD",
    sha256 = "96d33abb4bb0070c7be0fed4246cd38416188325f820468214471938545b1ac8",
    strip_prefix = "mpdecimal-4.0.1",
