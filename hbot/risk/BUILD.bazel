load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

cc_library(
    name = "lease", hdrs = ["lease.h"], srcs = ["lease.cc"],
    deps = ["//hbot/base:clock", "//hbot/base:decimal", "//hbot/base:ids", "@abseil-cpp//absl/container:flat_hash_map", "@abseil-cpp//absl/status:status", "@abseil-cpp//absl/status:statusor"],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "risk_gate",
    hdrs = ["risk_gate.h"],
    srcs = ["risk_gate.cc"],
    deps = [":lease", "//hbot/base:clock", "//hbot/base:decimal", "//hbot/base:ids", "//hbot/model:domain", "@abseil-cpp//absl/status:status", "@abseil-cpp//absl/status:statusor"],
    visibility = ["//visibility:public"],
)

cc_test(name = "risk_gate_test", srcs = ["risk_gate_test.cc"], deps = [":risk_gate"])
cc_test(name = "multi_shard_lease_test", srcs = ["multi_shard_lease_test.cc"], deps = [":lease", ":risk_gate"])
