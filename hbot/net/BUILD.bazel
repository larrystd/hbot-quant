load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

cc_library(
    name = "api", hdrs = ["api.h"],
    deps = ["@abseil-cpp//absl/status:statusor", "@boost.asio//:boost.asio"],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "transport",
    srcs = ["http_client.cc", "tls_config.cc", "websocket_client.cc"],
    hdrs = ["http_client.h", "tls_config.h", "websocket_client.h"],
    deps = [
        ":api",
        "@abseil-cpp//absl/status:status",
        "@abseil-cpp//absl/status:statusor",
        "@boost.asio//:boost.asio",
        "@boost.beast//:boost.beast",
        "@openssl//:ssl",
    ],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "rate_limit",
    srcs = ["rate_limit.cc"],
    hdrs = ["rate_limit.h"],
    deps = ["//hbot/base:ids", "@abseil-cpp//absl/status:status"],
    visibility = ["//visibility:public"],
)

cc_test(
    name = "rate_limit_test",
    srcs = ["rate_limit_test.cc"],
    deps = [":rate_limit", "@googletest//:gtest_main"],
)

cc_test(
    name = "http_client_test",
    srcs = ["http_client_test.cc"],
    deps = [":transport", "@boost.asio//:boost.asio", "@boost.beast//:boost.beast", "@googletest//:gtest_main"],
)

cc_test(
    name = "websocket_client_test",
    srcs = ["websocket_client_test.cc"],
    deps = [":transport", "@boost.asio//:boost.asio", "@boost.beast//:boost.beast", "@googletest//:gtest_main"],
)
