load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

cc_library(
    name = "control_server",
    hdrs = ["control_server.h"],
    srcs = ["control_server.cc"],
    deps = ["//hbot/control:protocol", "@abseil-cpp//absl/status:status", "@abseil-cpp//absl/status:statusor"],
    visibility = ["//visibility:public"],
)

cc_test(
    name = "control_server_test",
    srcs = ["control_server_test.cc"],
    deps = [":control_server", "//hbot/cli:cli", "@googletest//:gtest_main"],
)

cc_library(
    name = "engine",
