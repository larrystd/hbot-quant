    srcs = ["engine.cc"],
    deps = [
        ":control_server",
        "//hbot/app/config:config",
        "//hbot/connector/binance_spot/public:public",
        "//hbot/connector/paper:paper",
        "//hbot/control:protocol",
        "//hbot/risk:risk_gate",
        "//hbot/net:transport",
        "//hbot/runtime:replay_clock",
        "//hbot/runtime:shard",
        "//hbot/storage:history_reader",
        "//hbot/storage:sqlite_recorder",
        "//hbot/strategy:simple_pmm",
        "@abseil-cpp//absl/status:status",
        "@boost.asio//:boost.asio",
        "@simdjson//:simdjson",
    ],
    visibility = ["//visibility:public"],
